--// Stop On Move
RunService.RenderStepped:Connect(function()
    if character and character.PrimaryPart then
        if Settings["Stop On Move"] and CurrentTrack and CurrentTrack.IsPlaying then
            local moved = (character.PrimaryPart.Position - lastPosition).Magnitude > 0.1
            local jumped = humanoid and humanoid:GetState() == Enum.HumanoidStateType.Jumping
            if moved or jumped then StopTrack() end
        end
        lastPosition = character.PrimaryPart.Position
    end
end)

--// Collision Bypass
local originalCollisionStates = {}
local lastFixClipState = Settings["Allow Invisible"]

local function saveCollisionStates()
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part ~= humanoidRootPart then
            originalCollisionStates[part] = part.CanCollide
        end
    end
end

local function disableCollisions()
    if not Settings["Allow Invisible"] or not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part ~= humanoidRootPart then
            part.CanCollide = false
        end
    end
end

local function restoreCollisions()
    for part, val in pairs(originalCollisionStates) do
        if part and part.Parent then part.CanCollide = val end
    end
    originalCollisionStates = {}
end

local function setupCollisionLoop()
    saveCollisionStates()
    lastFixClipState = Settings["Allow Invisible"]
    local conn
    conn = RunService.Stepped:Connect(function()
        if character and character.Parent then
            local cur = Settings["Allow Invisible"]
            if lastFixClipState ~= cur then
                if cur then saveCollisionStates(); disableCollisions() else restoreCollisions() end
                lastFixClipState = cur
            elseif cur then
                disableCollisions()
            end
        else
            restoreCollisions()
            if conn then conn:Disconnect() end
        end
    end)
    trackConnection(conn)
end

setupCollisionLoop()

--// Respawn Handler
player.CharacterAdded:Connect(function(newChar)
    StopTrack()
    restoreCollisions()
    cleanupConnections()
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    setHipHeight(humanoid.HipHeight, true)
    lastPosition = humanoidRootPart.Position
    disableAnimations(character)
    setupCollisionLoop()
end)

