local Settings = {
    ["Stop On Move"]    = true,
    ["Fade In"]         = 0,
    ["Fade Out"]        = 1e29,
    ["Weight"]          = 1,
    ["Speed"]           = 0,
    ["Allow Invisible"] = true,
    ["Time Position"]   = 1,
}

local CurrentTrack
local lastPosition = (character.PrimaryPart and character.PrimaryPart.Position) or Vector3.new()
local activeConnections = {}

local function cleanupConnections()
    for _, conn in ipairs(activeConnections) do
        if conn and conn.Connected then pcall(function() conn:Disconnect() end) end
    end
    activeConnections = {}
end

local function trackConnection(conn)
    table.insert(activeConnections, conn)
    return conn
end

--// Emote ID Parser
local function extractIdFromInput(input)
    local num = tonumber(input)
    if num then return num end
    for _, pat in ipairs({
        "rbxassetid://(%d+)",
        "roblox%.com/catalog/(%d+)",
        "roblox%.com/library/(%d+)",
        "roblox%.com/asset/%?id=(%d+)",
    }) do
        local m = string.match(input, pat)
        if m then return tonumber(m) end
    end
    return nil
end

local resolvedAnimIdCache = {}

local function resolveAnimId(id)
    if resolvedAnimIdCache[id] then
        return resolvedAnimIdCache[id]
    end
    local animId
    local ok, result = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
    if ok and result and #result > 0 and result[1]:IsA("Animation") then
        animId = result[1].AnimationId
    else
        animId = "rbxassetid://" .. tostring(id)
    end
    resolvedAnimIdCache[id] = animId
    return animId
end

--// Animation Loader
local function LoadTrack(id)
    disableAnimations(character)

    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            pcall(function() track:Stop(0) end)
        end
    end
    if humanoid then
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            pcall(function() track:Stop(0) end)
        end
    end
    if CurrentTrack then
        pcall(function() CurrentTrack:Stop(0) end)
        CurrentTrack = nil
    end

    local animId = resolveAnimId(id)
    local newAnim = Instance.new("Animation")
    newAnim.AnimationId = animId

    local newTrack = animator and animator:LoadAnimation(newAnim) or humanoid:LoadAnimation(newAnim)
    newTrack.Priority = Enum.AnimationPriority.Action4

    newTrack:Play(Settings["Fade In"], Settings["Weight"], 1)
    CurrentTrack = newTrack

    task.spawn(function()
        local track = newTrack
        task.wait(0.2)
        if CurrentTrack == track then
            local len = track.Length
            if len > 0 and Settings["Time Position"] then
                local pct = math.clamp(Settings["Time Position"], 0, 1)
                local targetTime = pct * len
                if pct >= 1 then targetTime = math.max(0, len - 0.001) end
                track.TimePosition = math.clamp(targetTime, 0, math.max(0, len - 0.001))
            end
            track:AdjustSpeed(0)
            track:Stop(Settings["Fade Out"])
        end
    end)

    return newTrack
end

local function StopTrack()
    if CurrentTrack then CurrentTrack:Stop(0); CurrentTrack = nil end
end

