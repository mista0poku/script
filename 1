-- Keep HipHeight at or above 2 for both slider and text input.
local SLIDER_HIP_MIN, SLIDER_HIP_MAX = 2, 200

local function setHipHeight(value, bypassClamp)
    value = math.max(value, SLIDER_HIP_MIN)
    if not bypassClamp then
        value = math.clamp(value, SLIDER_HIP_MIN, SLIDER_HIP_MAX)
    end
    value = math.floor(value * 10) / 10
    hipLabel.Text = string.format("HipHeight: %.1f", value)
    hipInput.Text = string.format("%.1f", value)
    local rel = math.clamp((value - SLIDER_HIP_MIN) / (SLIDER_HIP_MAX - SLIDER_HIP_MIN), 0, 1)
    hipFill.Size = UDim2.new(rel, 0, 1, 0)
    hipThumb.Position = UDim2.new(rel, 0, 0.5, 0)
    if humanoid then humanoid.HipHeight = value end
end

local hipDragging = false
local function hipUpdateFromInput(input)
    local rel = math.clamp((input.Position.X - hipSliderBar.AbsolutePosition.X) / hipSliderBar.AbsoluteSize.X, 0, 1)
    setHipHeight(SLIDER_HIP_MIN + (SLIDER_HIP_MAX - SLIDER_HIP_MIN) * rel, false)
end

